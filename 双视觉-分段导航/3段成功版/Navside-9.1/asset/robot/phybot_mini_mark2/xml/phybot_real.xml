<mujoco model="phybot_street_scene">
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>
  <option timestep="0.002" iterations='10' solver='PGS' gravity='0 0 -9.81' >
  </option>
  <size njmax="2000" nconmax="500" />
  
  <visual>
      <quality shadowsize='8192'/>
      <map force="0.1" zfar="1000" znear='0.05'/>
      <rgba haze="0.15 0.25 0.35 1"/>
      <global offwidth="2560" offheight="1440" elevation="-20" azimuth="120"/>
  </visual>

  <statistic center="0 0 1" extent="10"/>
  
  <default>
    <geom  condim='4' solref='0.001 2' friction='1.0 0.5 0.5'/>
    <equality solref='0.001 2'/>
  </default>

  <default>
    <default class="phybot_mini_mark2">
      <joint damping="0.1" armature="0.1"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom group="3" mass="0" density="0" friction="1.0 0.5 0.5" />
      </default>
    </default>
    
    <!-- 障碍物默认属性：有碰撞，有质量(或固定) -->
    <default class="obstacle">
        <geom condim="3" contype="1" conaffinity="1" friction="0.8 0.5 0.5"/>
    </default>
  </default>

  <!-- ==================== 资源定义 ==================== -->
  <asset>
    <!-- 1. 机器人网格 -->
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="left_hip_pitch" file="left_hip_pitch.STL"/>
    <mesh name="left_hip_roll" file="left_hip_roll.STL"/>
    <mesh name="left_hip_yaw" file="left_hip_yaw.STL"/>
    <mesh name="left_knee" file="left_knee.STL"/>
    <mesh name="right_ankle_pitch" file="right_ankle_pitch.STL"/>
    <mesh name="left_ankle_roll" file="left_ankle_roll.STL"/>
    <mesh name="right_hip_pitch" file="right_hip_pitch.STL"/>
    <mesh name="right_hip_roll" file="right_hip_roll.STL"/>
    <mesh name="right_hip_yaw" file="right_hip_yaw.STL"/>
    <mesh name="right_knee" file="right_knee.STL"/>
    <mesh name="right_ankle_roll" file="right_ankle_roll.STL"/>
    <mesh name="torso" file="torso.STL"/>
    <mesh name="left_shoulder_pitch" file="left_shoulder_pitch.STL"/>
    <mesh name="left_shoulder_roll" file="left_shoulder_roll.STL"/>
    <mesh name="left_shoulder_yaw" file="left_shoulder_yaw.STL"/>
    <mesh name="left_elbow_pitch" file="left_elbow_pitch.STL"/>
    <mesh name="right_shoulder_pitch" file="right_shoulder_pitch.STL"/>
    <mesh name="right_shoulder_roll" file="right_shoulder_roll.STL"/>
    <mesh name="right_shoulder_yaw" file="right_shoulder_yaw.STL"/>
    <mesh name="right_elbow_pitch" file="right_elbow_pitch.STL"/>
    <mesh name="right_elbow_yaw" file="right_elbow_yaw.STL"/>
    <mesh name="neck_yaw" file="neck_yaw.STL"/>
    <mesh name="neck_pitch" file="neck_pitch.STL"/>
    
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
    
    <!-- 2. 场景纹理 -->
    <!-- [ROAD] 地面 -->
    <texture name="tex_asphalt" type="2d" file="textures/sidewalk.png"/>
    <material name="mat_road" texture="tex_asphalt" texrepeat="1 1" reflectance="0" shininess="0" specular="0.1" texuniform="true"/>

    <!-- 人行道 -->
    <texture name="tex_sidewalk" type="2d" file="textures/sidewalk.png"/>
    <material name="mat_sidewalk" texture="tex_sidewalk" texrepeat="2 2.5" reflectance="0" shininess="0" specular="0.1" texuniform="true"/>

    <!--楼房侧面 -->
    <texture name="tex_building" type="2d" file="textures/building1.png"/>
    
    <!-- 添加 texuniform="true"，texrepeat 为 1 1 (每米重复1次) -->
    <!-- 保证细节清晰 -->
    <material name="mat_building_real_1" texture="tex_building" texrepeat="1 1" texuniform="true" emission="0.3" reflectance="0" shininess="0" rgba="1 1 1 1"/>

    <material name="mat_building_real_2" texture="tex_building" texrepeat="1 1" texuniform="true" emission="0.3" reflectance="0" shininess="0" rgba="0.9 0.9 1.0 1"/>

    <!-- 屋顶 -->
    <texture name="tex_roof" type="2d" builtin="flat" rgb1="0.4 0.4 0.45" width="128" height="128"/>
    <material name="mat_roof" texture="tex_roof" reflectance="0.05"/>
    
    <!-- 汽车材质 -->
    <material name="mat_car_body" rgba="0.8 0.1 0.1 1" specular="0.8" shininess="0.5" reflectance="0.3"/>
    <material name="mat_car_body_blue" rgba="0.1 0.1 0.8 1" specular="0.8" shininess="0.5" reflectance="0.3"/>
    <material name="mat_car_glass" rgba="0.1 0.1 0.2 0.8" specular="1" shininess="0.9" reflectance="0.5"/>
    <material name="mat_car_wheel" rgba="0.1 0.1 0.1 1" specular="0" shininess="0"/>
    <!-- 行人材质 -->
    <material name="mat_person_1" rgba="0.2 0.6 0.2 1"/>
    <material name="mat_person_2" rgba="0.8 0.5 0.2 1"/>
    <material name="mat_skin" rgba="0.9 0.7 0.6 1"/>
    <!-- 路灯材质 -->
    <material name="mat_pole" rgba="0.3 0.3 0.3 1" specular="0.5" shininess="0.5"/>
    <material name="mat_light_bulb" rgba="1 1 0.8 1" emission="1"/>
    <!-- 路障材质 -->
    <material name="mat_cone_orange" rgba="1 0.5 0 1" reflectance="0.5"/>
    
    <mesh name="mesh_table_chairs" file="Table And Chairs.obj" scale="0.02 0.02 0.02"/>
    <material name="mat_wood" rgba="0.6 0.4 0.2 1" specular="0.1" shininess="0.1"/>
    
    <mesh name="mesh_car" file="car.obj" scale="0.03 0.03 0.03"/>
    <material name="mat_car" rgba="0.8 0.1 0.1 1" specular="0.1" shininess="0.1"/>
    
    <mesh name="mesh_tree" file="tree.obj" scale="0.7 0.7 0.7"/>
    <texture name="tex_tree" type="2d" file="textures/tree.png"/>
    <material name="mat_tree" texture="tex_tree" rgba="0.2 0.8 0.1 1" specular="0.1" shininess="0.1"/>
    
    <mesh name="mesh_human" file="human.obj" scale="0.015 0.015 0.015"/>
    <material name="mat_human" rgba="0.2 0.4 0.3 1" specular="0.1" shininess="0.1"/>
    
  </asset>


  <!-- ==================== 场景构建 ==================== -->
  <worldbody>
    <!-- 增加一点环境光(ambient)，确保暗部也有细节 -->
    <light pos="0 0 15" dir="0 0 -1" directional="true" castshadow="true" diffuse="0.9 0.9 0.9" specular="0.1 0.1 0.1"/>

    <!-- 地面 -->
    <geom name="road_ground" type="plane" pos="0 0 0" size="50 50 0.125" material="mat_road" condim="3" conaffinity="1" contype="1" rgba="1 1 1 1"/>
 
    <!-- 左侧路灯 -->
    <body name="streetlight_L1" pos="-10 6.5 0">
        <geom type="cylinder" size="0.1 3" pos="0 0 3" material="mat_pole" class="obstacle"/> <!-- 柱子 -->
        <geom type="cylinder" size="0.08 0.5" pos="0 -0.5 5.8" euler="1.57 0 0" material="mat_pole" class="obstacle"/> <!-- 横杆 -->
        <geom type="sphere" size="0.2" pos="0 -1.0 5.6" material="mat_light_bulb" class="obstacle"/> <!-- 灯泡 -->
        <light pos="0 -1.0 5.0" dir="0 0 -1" diffuse="0.8 0.8 0.6" attenuation="1 0 0"/> <!-- 真实点光源 -->
    </body>
    <body name="streetlight_L2" pos="10 6.5 0">
        <geom type="cylinder" size="0.1 3" pos="0 0 3" material="mat_pole" class="obstacle"/>
        <geom type="cylinder" size="0.08 0.5" pos="0 -0.5 5.8" euler="1.57 0 0" material="mat_pole" class="obstacle"/>
        <geom type="sphere" size="0.2" pos="0 -1.0 5.6" material="mat_light_bulb" class="obstacle"/>
    </body>
    <body name="streetlight_L3" pos="30 6.5 0">
        <geom type="cylinder" size="0.1 3" pos="0 0 3" material="mat_pole" class="obstacle"/>
        <geom type="cylinder" size="0.08 0.5" pos="0 -0.5 5.8" euler="1.57 0 0" material="mat_pole" class="obstacle"/>
        <geom type="sphere" size="0.2" pos="0 -1.0 5.6" material="mat_light_bulb" class="obstacle"/>
    </body>
    <!-- 右侧路灯 -->
    <body name="streetlight_R1" pos="0 -6.5 0">
        <geom type="cylinder" size="0.1 3" pos="0 0 3" material="mat_pole" class="obstacle"/>
        <geom type="cylinder" size="0.08 0.5" pos="0 0.5 5.8" euler="1.57 0 0" material="mat_pole" class="obstacle"/>
        <geom type="sphere" size="0.2" pos="0 1.0 5.6" material="mat_light_bulb" class="obstacle"/>
    </body>
    <body name="streetlight_R2" pos="20 -6.5 0">
        <geom type="cylinder" size="0.1 3" pos="0 0 3" material="mat_pole" class="obstacle"/>
        <geom type="cylinder" size="0.08 0.5" pos="0 0.5 5.8" euler="1.57 0 0" material="mat_pole" class="obstacle"/>
        <geom type="sphere" size="0.2" pos="0 1.0 5.6" material="mat_light_bulb" class="obstacle"/>
    </body>
    <!-- 目标点 -->
    <body name="target_marker_body" pos="0 0 0">
        <geom name="target_marker" type="sphere" size="0.01" rgba="0 1 0 1" contype="0" conaffinity="0"/>
    </body>
    
        <!-- 桌椅障碍物 -->
    <body name="obstacle_furniture" pos="2.5 0 0.05" euler="0 0 0">
        <!-- ================== 视觉层 (Visual) ================== -->
        <!-- group="2" 是之前定义的视觉组，contype/conaffinity=0 表示无物理碰撞 -->
        <geom type="mesh" mesh="mesh_table_chairs" material="mat_wood"
              contype="0" conaffinity="0" group="2" 
              pos="0 0 0" euler="1.57 0 0"/> 
              <!-- 注意：很多 obj 导入后会躺在地上，通常需要绕 X 轴转 90 度 (1.57 弧度) 立起来，如果方向不对请调整这里 -->
        <!-- ================== 物理层 (Collision) ================== -->
        <!-- 这一层负责“挡路”，用简单的几何体 -->
        <!-- 用一个隐形的大盒子把桌椅全包起来，机器人走不过去 -->
        <!-- 假设桌椅占地 2米x2米，高1米 -->
        <geom type="box" size="1.0 1.0 0.5" pos="0 0 0.5" 
              class="obstacle" group="3" rgba="1 0 0 0.5"/> 
              <!-- rgba最后一位是0表示全透明(隐形)。调试时可以改成 0.5 看看盒子在哪 -->
    </body>
    
    <body name="obstacle_furniture1" pos="2 13 0.05" euler="0 0 0">
        <geom type="mesh" mesh="mesh_table_chairs" material="mat_wood"
              contype="0" conaffinity="0" group="2" 
              pos="0 0 0" euler="1.57 0 0"/> 
        <geom type="box" size="1.0 1.0 0.5" pos="0 0 0.5" 
              class="obstacle" group="3" rgba="1 0 0 0.5"/> 
    </body>
    
